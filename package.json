{
  "name": "lojban-1chat-bridge",
  "description": "Telegram <-> Discord <-> Slack <-> IRC <-> Mattermost <-> MAX gateway",
  "version": "2.0.0",
  "packageManager": "pnpm@10.32.1",
  "bin": {
    "Lojban-1Chat-Bridge": "./dist/bridge.js"
  },
  "scripts": {
    "tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\"",
    "format": "prettier --config src/.prettierrc --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --config src/.prettierrc --check \"src/**/*.{ts,tsx,json}\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "genconfig": "node ./dist/bridge.js --genconfig",
    "build": "pnpm install && pnpm run tsc",
    "dev": "ts-node src/bridge.ts",
    "start": "node ./dist/bridge.js"
  },
  "licenses": [
    {
      "type": "MIT"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lagleki/Lojban-1Chat-Bridge.git"
  },
  "bugs": "https://github.com/lagleki/Lojban-1Chat-Bridge/issues",
  "homepage": "https://github.com/lagleki/Lojban-1Chat-Bridge",
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "sharp"
    ]
  },
  "dependencies": {
    "@maxhub/max-bot-api": "^0.2.2",
    "@napi-rs/canvas": "^0.1.97",
    "@slack/rtm-api": "^7.0.4",
    "@slack/web-api": "^7.15.0",
    "@vk-io/authorization": "^1.4.0",
    "await-timeout": "^1.1.1",
    "await-to-js": "^3.0.0",
    "axios": "^1.13.6",
    "buffer": "^6.0.3",
    "color-space": "2.0.0",
    "delta-e": "0.0.8",
    "discord-markdown": "^2.5.1",
    "discord.js": "12.5.3",
    "dompurify": "^3.0.0",
    "emoji-aware": "^3.1.0",
    "finalhandler": "^1.2.0",
    "fs-extra": "^11.1.0",
    "happy-dom": "^20.8.4",
    "html-entities": "2.3.3",
    "htmlparser": "^1.7.7",
    "irc-upd": "^0.11.0",
    "lojban": "^2.0.48",
    "marked": "^4.2.12",
    "mkdirp": "^2.1.3",
    "node-emoji": "^1.11.0",
    "node-telegram-bot-api": "^0.61.0",
    "node-vk-bot-api": "^3.5.0",
    "p-queue": "^6.6.2",
    "ramda": "^0.28.0",
    "randexp": "^0.5.3",
    "reconnecting-websocket": "^4.4.0",
    "sanitize-html": "^2.10.0",
    "serve-static": "^1.15.0",
    "sharp": "^0.31.3",
    "socket.io": "^4.6.1",
    "twemoji-parser": "^14.0.0",
    "vk-io": "^4.10.1",
    "winston": "^3.8.2",
    "winston-daily-rotate-file": "^4.7.1",
    "ws": "^8.12.1"
  },
  "devDependencies": {
    "@types/delta-e": "^0.0.0",
    "@types/finalhandler": "^1.2.4",
    "@types/fs-extra": "^11.0.1",
    "@types/marked": "^4.0.8",
    "@types/node": "^25.5.0",
    "@types/node-telegram-bot-api": "^0.61.2",
    "@types/serve-static": "^2.2.0",
    "@types/ws": "^8.5.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.34.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
